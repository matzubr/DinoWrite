{
    "paths":{
        "fb_folder":  "$HIP/../preview/{name}",
        "fb_name":    "{name}.{version}.$F4.{fileformat}",
        "fb_video_ext": "mov"
    },
    "formats":{
        "video_exts": ["mov","mp4"],
        "pic_exts":   ["exr","jpg","png"]
    },
    "custom_resolution":[
        "3840 2160",
        "2048 1080",
        "2048 800",
        "1920 1080",
        "1280 720"
    ],
    "custom_framerange":{
        "From Current Frame To Global End": "$F $FEND",
        "From Global Start To Current Frame": "$FSTART $F",
        "From Current Frame To Playbar End": "$F $RFEND",
        "From Playbar Start To Current Frame": "$RFSTART $F"
    },
    "ffmpeg_cmd":[
        "ffmpeg",
        "-y",
        "-r {fps}",
        "-start_number {start_frame}",
        "-i {input}",
        "{audio_input}",
        "-vf {vf}",
        "-s {resolution}",
        "-aspect {aspect}",
        "{codec}",
        "{audio}",
        "-pix_fmt yuv420p",
        "-color_primaries bt709",
        "-color_trc {color_trc}",
        "-colorspace bt709",
        "-color_range tv",
        "{metadata}",
        "{output}"
    ],
    "advanced":{
        "true_resolution": "auto",
        "open_after": "video_folder",
        "ffmpeg_path": "",
        "video_codec": "auto",
        "video_quality": "high",
        "exr_acescg": true,
        "exr_compression": "dwaa_fine",
        "ldr_matte_paint": true,
        "ldr_colorspace": "auto",
        "video_audio": true,
        "oiiotool_path": "",
        "delete_incomplete_fb":false,
        "conversion_delete_input_sequence":true
    }
}
