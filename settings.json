{
    "paths":{
        "fb_folder":  "$HIP/../preview/{name}",
        "fb_name":    "{name}.{version}.$F4.{fileformat}",
        "tmp_folder": "$HOUDINI_TEMP_DIR/DinoWrite",
        "tmp_data":   "data.json",
        "fb_video_ext": "mov"
    },
    "formats":{
        "video_exts": ["mov","mp4"],
        "pic_exts":   ["exr","jpg","png"]
    },
    "custom_resolution":[
        "3840 2160",
        "2048 1080",
        "2048 800",
        "1920 1080",
        "1280 720"
    ],
    "custom_framerange":{
        "From Current Frame To Global End": "$F $FEND",
        "From Global Start To Current Frame": "$FSTART $F",
        "From Current Frame To Playbar End": "$F $RFEND",
        "From Playbar Start To Current Frame": "$RFSTART $F"
    },
    "ffmpeg_cmd":[
        "ffmpeg",
        "-y",
        "-r {fps}",
        "-start_number {start_frame}",
        "-i {input}",
        "-vf {vf}",
        "-s {resolution}",
        "-aspect {aspect}",
        "{codec}",
        "-pix_fmt yuv420p",
        "-color_primaries bt709",
        "-color_trc {color_trc}",
        "-colorspace bt709",
        "-color_range tv",
        "{output}"
    ],
    "advanced":{
        "true_resolution": "auto",
        "open_after": "video",
        "ffmpeg_path": "",
        "video_codec": "auto",
        "color_transform": "ocio",
        "ocio_source": "mplay",
        "ocio_display": "",
        "ocio_view": "",
        "ocio_input_space": "scene_linear",
        "oiiotool_path": "",
        "ocio_processes": 0,
        "delete_incomplete_fb":false,
        "conversion_delete_input_sequence":true,
        "aspect_affects_resolution":false,
        "metadata":[
            "author:$CEREBRO_USER_NAME",
            "hipname:$HIPNAME",
            "hipfile:{hipfile}"
        ]
    }
}
